includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - online-active-users.php
        - class-webi-custom-widget.php
        - uninstall.php
        - inc
    excludePaths:
        - vendor/*
        - tests/*
    bootstrapFiles:
        - vendor/szepeviktor/phpstan-wordpress/bootstrap.php
        - phpstan-bootstrap.php
